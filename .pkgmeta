# BigWigs packager config: builds TavernDice-<tag>.zip and uploads it.
package-as: TavernDice

ignore:
  - tests
  - CLAUDE.md
  - WOW_ADDON_PLAYBOOK.md
  - .github
  - github-workflows
  - curseforge
  - .gitignore

# Use our CHANGELOG.md as the changelog on CurseForge / GitHub releases
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
